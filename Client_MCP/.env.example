# Copy to .env and fill in. .env is gitignored; this file is not.
# Host only - no path, no trailing slash.
CANVAS_URL=https://your-school.instructure.com
# Canvas > Account > Settings > New Access Token
CANVAS_TOKEN=
# console.anthropic.com -> API keys
ANTHROPIC_KEY=

# Where the FocusLab backend is, for the notes tools. Leave unset outside
# Docker; compose overrides it with the backend's service name.
FOCUSLAB_API_URL=http://localhost:8000
