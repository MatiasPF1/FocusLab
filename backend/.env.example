# Copy to .env and fill in. .env is gitignored; this file is not.

####
# Spotify
####
# Create an app here: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Register this exact URI in the dashboard. Spotify banned "localhost" on
# 2025-11-27, so the loopback IP is required.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

####
# Frontend
####
# Where the backend sends the browser once Spotify login finishes.
FRONTEND_URL=http://localhost:3000

####
# Canvas (optional)
####
# Only needed if you run the Canvas routes from the backend. The MCP server
# reads Client_MCP/.env first and falls back to this file.
# Host only - no path, no trailing slash.
CANVAS_URL=https://your-school.instructure.com
# Canvas > Account > Settings > New Access Token
CANVAS_TOKEN=
